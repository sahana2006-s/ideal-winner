import re

def validate_credit_cards():
    
    try:
        n = int(input())
    except EOFError:
        return

    for _ in range(n):
        card = input().strip()
        
        
        is_format_valid = re.match(r'^[456]\d{3}(-?\d{4}){3}$', card)
        
        if is_format_valid:
            
            raw_digits = card.replace("-", "")
           
            if not re.search(r'(\d)\1{3,}', raw_digits):
                print("Valid")
            else:
                print("Invalid")
        else:
            print("Invalid")


validate_credit_cards()
